#!/bin/bash
# send-investor-rapport — Generer og send sammenlignende investoranalyse via Claude Code CLI
#
# Bruk:
#   send-investor-rapport "Selskap1, Selskap2, Selskap3"
#   send-investor-rapport "DNB, Equinor, Aker BP" --to "annen@epost.no"
#   send-investor-rapport "Capgemini, TCS" --budget 1.00
#
# Standardmottaker: lsoraas@gmail.com
# Rapporter lagres i: /home/lars/.openclaw/workspace/rapporter/
# Rapporter legges automatisk til i RAG-kunnskapsbasen.

set -e

# --- Argumentparsing ---
SELSKAPER=""
MOTTAKER="lsoraas@gmail.com"
BUDSJETT="0.80"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)     MOTTAKER="$2"; shift 2 ;;
    --budget) BUDSJETT="$2"; shift 2 ;;
    *)        SELSKAPER="$1"; shift ;;
  esac
done

if [[ -z "$SELSKAPER" ]]; then
  echo "Feil: Oppgi selskapsnavn som første argument."
  echo "Eksempel: send-investor-rapport \"DNB, Equinor, Aker BP\""
  exit 1
fi

DATO=$(date +%Y-%m-%d)
MALSTI="/home/lars/.openclaw/workspace/templates/investorsammenligning.html"
RAPPORTDIR="/home/lars/.openclaw/workspace/rapporter"

# Lag filnavn-slug fra selskapsnavn: "Aker BP, Vår Energi" → "aker-bp-var-energi"
SLUG=$(echo "$SELSKAPER" \
  | sed 's/[æÆ]/ae/g; s/[øØ]/o/g; s/[åÅ]/a/g' \
  | tr '[:upper:]' '[:lower:]' \
  | tr -cs 'a-z0-9' '-' \
  | sed 's/^-//;s/-$//')

UTFIL="${RAPPORTDIR}/${DATO}_${SLUG}.html"
RAG_KILDE="rapport_${DATO}_${SLUG}"

mkdir -p "$RAPPORTDIR"

# --- Sjekk arkiv: send eksisterende hvis under 7 dager gammel ---
for kandidat in "$RAPPORTDIR"/*_"${SLUG}".html; do
  [[ -f "$kandidat" ]] || continue
  # Utelukk dybde- og sammenligningsfiler
  [[ "$(basename "$kandidat")" == *dybde* ]] && continue
  [[ "$(basename "$kandidat")" == *sammenligning* ]] && continue
  alder_dager=$(( ( $(date +%s) - $(date -r "$kandidat" +%s 2>/dev/null || stat -c %Y "$kandidat" 2>/dev/null || echo 0) ) / 86400 ))
  if [[ $alder_dager -lt 7 ]]; then
    LAGRET_DATO=$(basename "$kandidat" .html | cut -d_ -f1)
    echo "✅ Denne analysen lå allerede klar i arkivet fra ${LAGRET_DATO} — sender den til deg nå, ingen ny analyse nødvendig."
    /home/lars/.local/bin/hmail \
      --to "$MOTTAKER" \
      --subject "Investoranalyse: $SELSKAPER ($LAGRET_DATO) [fra arkiv]" \
      --file "$kandidat"
    echo "Sendt fra arkiv: $kandidat"
    exit 0
  fi
done

echo "=== send-investor-rapport ==="
echo "Selskaper : $SELSKAPER"
echo "Mottaker  : $MOTTAKER"
echo "Budsjett  : USD $BUDSJETT"
echo "Lagres    : $UTFIL"
echo "RAG-kilde : $RAG_KILDE"
echo ""
echo "Starter Claude Code CLI..."

PROMPT="Du er en analytiker som lager investorrapporter.

Din oppgave: Lag en sammenlignende investoranalyse av følgende selskaper: $SELSKAPER

INSTRUKSJONER:
1. Søk etter oppdatert finansdata for hvert selskap: kurs, P/E (trailing og forward), EV/EBITDA, direkteavkastning/utbytte, siste årsomsetning og vekst, driftsmargin, nettoresultat, netto gjeld/gjeldsrate, analytikerkonsensus og kursmål.
2. Les malen fra filen: $MALSTI
3. Generer en ny komplett HTML-rapport basert på malens stil og CSS. Behold alle CSS-stilene eksakt. Erstatt innhold med data for de nye selskapene. Tilpass antall kolonner til antall selskaper.
4. Rapporten skal skrives på norsk og tilpasses en privat småinvestor uten finansbakgrunn. Forklar faguttrykk underveis (som malen gjør).
5. Lagre den ferdige HTML-rapporten til: $UTFIL
6. Send rapporten som HTML-epost med kommandoen: /home/lars/.local/bin/hmail --to \"$MOTTAKER\" --subject \"Investoranalyse: $SELSKAPER ($DATO)\" --file $UTFIL
7. Bekreft at eposten ble sendt.

Dato i dag: $DATO
Husk: ALDRI fabrikere finansdata — søk etter reelle oppdaterte tall."

TMPOUT=$(mktemp --suffix=.html)

set +e
claude-kjor \
  --tittel "Investoranalyse: $SELSKAPER" \
  --mottaker "$MOTTAKER" \
  -- \
  --dangerously-skip-permissions \
  --model claude-haiku-4-5-20251001 \
  --max-budget-usd "$BUDSJETT" \
  --print \
  "$PROMPT" | tee "$TMPOUT"
CLAUDE_OK=${PIPESTATUS[0]}
set -e

if [[ $CLAUDE_OK -ne 0 ]]; then
  echo "FEIL: claude-kjor avsluttet med kode $CLAUDE_OK."
  rm -f "$TMPOUT"
  exit $CLAUDE_OK
fi

if [[ ! -f "$UTFIL" ]]; then
  if [[ -s "$TMPOUT" ]]; then
    echo ""
    echo "Rapport ikke lagret av Claude — lagrer fra stdout-buffer..."
    cp "$TMPOUT" "$UTFIL"
    /home/lars/.local/bin/hmail \
      --to "$MOTTAKER" \
      --subject "Investoranalyse: $SELSKAPER ($DATO)" \
      --file "$UTFIL" \
      && echo "Epost sendt." \
      || echo "ADVARSEL: Epostsending feilet."
  else
    echo "ADVARSEL: Ingen rapport å lagre — stdout var tom."
  fi
fi
rm -f "$TMPOUT"

# --- Legg til i RAG ---
if [[ -f "$UTFIL" ]]; then
  echo ""
  echo "Legger rapport til i RAG-kunnskapsbasen som: $RAG_KILDE"
  /home/lars/.local/bin/rag add "$UTFIL" "$RAG_KILDE" \
    && echo "RAG: OK" \
    || echo "RAG: FEIL (rapporten er likevel lagret på disk)"
else
  echo "ADVARSEL: Rapportfil ikke funnet på $UTFIL — RAG-ingestion hoppet over."
fi

echo ""
echo "=== Ferdig ==="
echo "Rapport lagret: $UTFIL"
echo "For å sende på nytt: hmail --to \"MOTTAKER\" --subject \"...\" --file $UTFIL"
