#!/bin/bash
# sammenlign-rapporter — Sammenlign to lagrede investorrapporter med Claude
#
# Bruk:
#   sammenlign-rapporter "olje-gass" "sjomat"
#   sammenlign-rapporter "2026-02-22_olje-gass" "2026-01-15_finans"
#   sammenlign-rapporter "olje-gass" "fornybar" --to "annen@epost.no"
#   sammenlign-rapporter "olje-gass" "sjomat" --budget 1.00
#
# Finner automatisk nyeste rapport som matcher hvert søkeord.

set -e

RAPPORTDIR="/home/lars/.openclaw/workspace/rapporter"
MALSTI="/home/lars/.openclaw/workspace/templates/investorsammenligning.html"
MOTTAKER="lsoraas@gmail.com"
BUDSJETT="0.80"
RAPPORT1=""
RAPPORT2=""

# --- Argumentparsing ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)     MOTTAKER="$2"; shift 2 ;;
    --budget) BUDSJETT="$2"; shift 2 ;;
    *)        POSITIONAL+=("$1"); shift ;;
  esac
done

if [[ ${#POSITIONAL[@]} -lt 2 ]]; then
  echo "Feil: Oppgi to rapportnavn/-søkeord."
  echo ""
  echo "Bruk:    sammenlign-rapporter \"<søk1>\" \"<søk2>\""
  echo "Eksempel: sammenlign-rapporter \"olje-gass\" \"sjomat\""
  echo ""
  echo "Tilgjengelige rapporter:"
  ls "$RAPPORTDIR"/*.html 2>/dev/null | xargs -I{} basename {} .html | sed 's/^/  /'
  exit 1
fi

SOK1="${POSITIONAL[0]}"
SOK2="${POSITIONAL[1]}"

# --- Finn filer (nyeste match per søkeord) ---
finn_rapport() {
  local sok="$1"
  # Prøv eksakt filnavn først
  if [[ -f "$RAPPORTDIR/${sok}.html" ]]; then
    echo "$RAPPORTDIR/${sok}.html"
    return
  fi
  # Søk etter nyeste fil som matcher søkeordet
  local treff
  treff=$(ls -t "$RAPPORTDIR"/*"${sok}"*.html 2>/dev/null | head -1)
  if [[ -z "$treff" ]]; then
    echo ""
  else
    echo "$treff"
  fi
}

FIL1=$(finn_rapport "$SOK1")
FIL2=$(finn_rapport "$SOK2")

if [[ -z "$FIL1" ]]; then
  echo "Feil: Fant ingen rapport som matcher \"$SOK1\""
  echo "Tilgjengelige: $(ls "$RAPPORTDIR"/*.html 2>/dev/null | xargs -I{} basename {} .html | tr '\n' ', ')"
  exit 1
fi

if [[ -z "$FIL2" ]]; then
  echo "Feil: Fant ingen rapport som matcher \"$SOK2\""
  echo "Tilgjengelige: $(ls "$RAPPORTDIR"/*.html 2>/dev/null | xargs -I{} basename {} .html | tr '\n' ', ')"
  exit 1
fi

NAVN1=$(basename "$FIL1" .html)
NAVN2=$(basename "$FIL2" .html)
DATO=$(date +%Y-%m-%d)
SLUG="sammenligning_${NAVN1}_vs_${NAVN2}"
UTFIL="${RAPPORTDIR}/${DATO}_${SLUG}.html"
RAG_KILDE="rapport_${DATO}_${SLUG}"

# --- Sjekk arkiv: send eksisterende hvis under 7 dager gammel ---
for kandidat in "$RAPPORTDIR"/*_sammenligning_"${NAVN1}"_vs_"${NAVN2}".html \
                "$RAPPORTDIR"/*_sammenligning_"${NAVN2}"_vs_"${NAVN1}".html; do
  [[ -f "$kandidat" ]] || continue
  alder_dager=$(( ( $(date +%s) - $(date -r "$kandidat" +%s 2>/dev/null || stat -c %Y "$kandidat" 2>/dev/null || echo 0) ) / 86400 ))
  if [[ $alder_dager -lt 7 ]]; then
    LAGRET_DATO=$(basename "$kandidat" .html | cut -d_ -f1)
    echo "✅ Denne sammenligningen lå allerede klar i arkivet fra ${LAGRET_DATO} — sender den til deg nå, ingen ny analyse nødvendig."
    /home/lars/.local/bin/hmail \
      --from "Klarsyn Analyse <testkonto5221@gmail.com>" \
      --to "$MOTTAKER" \
      --subject "Sammenligning: $SOK1 vs $SOK2 ($LAGRET_DATO) [fra arkiv]" \
      --file "$kandidat"
    echo "Sendt fra arkiv: $kandidat"
    exit 0
  fi
done

echo "=== sammenlign-rapporter ==="
echo "Rapport 1 : $FIL1"
echo "Rapport 2 : $FIL2"
echo "Mottaker  : $MOTTAKER"
echo "Budsjett  : USD $BUDSJETT"
echo "Lagres    : $UTFIL"
echo ""
echo "Starter Claude Code CLI..."

PROMPT="Du er en erfaren finansanalytiker som sammenligner to investorrapporter.

RAPPORT 1: $FIL1
RAPPORT 2: $FIL2

OPPGAVE:
1. Les begge rapportene grundig.
2. Les HTML-malen: $MALSTI (bruk samme CSS og struktur)
3. Lag en ny sammenlignende HTML-rapport som fokuserer på:

   a) DIREKTESAMMENLIGNING: Plasser nøkkeltall fra begge rapporter side om side i tabeller (P/E, EV/EBITDA, direkteavkastning, vekst, margin, gjeld)
   b) RELATIV VERDSETTELSE: Hvilken gruppe er billigst/dyrest, og er det berettiget?
   c) RISIKOSAMMENLIGNING: Hvilken gruppe har lavest/høyest risiko? Hvilke risikotyper dominerer i hver?
   d) DIVERSIFISERING: Utfyller de to gruppene hverandre? Korrelasjonsrisiko?
   e) INVESTERINGSHORISONT — seksjon 6 skal ALLTID formateres som en HTML-tabell med følgende rader og to kolonner (én per gruppe). Bruk 🟢/🟡/🔴 for å signalisere egnethet:

      <table>
        <tr><th>Investorprofil</th><th>[GRUPPE 1 NAVN]</th><th>[GRUPPE 2 NAVN]</th></tr>
        <tr><td>Utbytte-investor</td><td>🟢/🟡/🔴 + kort begrunnelse</td><td>🟢/🟡/🔴 + kort begrunnelse</td></tr>
        <tr><td>Vekst-investor</td><td>...</td><td>...</td></tr>
        <tr><td>Verdi-investor</td><td>...</td><td>...</td></tr>
        <tr><td>Defensiv investor</td><td>...</td><td>...</td></tr>
        <tr><td>Risikotoleranse</td><td>Høy / Middels / Lav</td><td>Høy / Middels / Lav</td></tr>
        <tr><td>Anbefalt horisont</td><td>X–Y år</td><td>X–Y år</td></tr>
      </table>

   f) KONKLUSJON: Hvis du måtte velge mellom å investere i gruppe 1 ELLER gruppe 2, hva velger du og hvorfor? Og er det fornuftig å eie begge?

4. Rapporten skal:
   - Skrives på norsk
   - Tilpasses en privat småinvestor uten finansbakgrunn
   - Forklare eventuelle faguttrykk
   - Ha tydelige tabeller med begge grupper side om side
   - Ha en tydelig anbefaling til slutt
   - ALDRI bruke CSS grid (display: grid) eller flexbox (display: flex) — disse fungerer IKKE i e-postklienter. Bruk tabeller for all layout.
   - WCAG-kontrast: bruk ALDRI farger lysere enn #4a5568 for tekst. Grå tekst: #4a5568, orange: #9a3412.
   - Avsluttes med footer: <p class=\"note\" style=\"text-align: center; margin-top: 24px; border-top: 1px solid #e2e8f0; padding-top: 12px;\">Generert av <strong>Klarsyn Analyse</strong></p>

5. Lagre rapporten til: $UTFIL

Dato i dag: $DATO"

TMPOUT=$(mktemp --suffix=.html)

set +e
claude-kjor \
  --tittel "Sammenligning: $NAVN1 vs $NAVN2" \
  --mottaker "$MOTTAKER" \
  -- \
  --dangerously-skip-permissions \
  --model claude-haiku-4-5-20251001 \
  --max-budget-usd "$BUDSJETT" \
  --print \
  "$PROMPT" | tee "$TMPOUT"
CLAUDE_OK=${PIPESTATUS[0]}
set -e

if [[ $CLAUDE_OK -ne 0 ]]; then
  echo "FEIL: claude-kjor avsluttet med kode $CLAUDE_OK."
  rm -f "$TMPOUT"
  exit $CLAUDE_OK
fi

if [[ ! -f "$UTFIL" ]]; then
  if grep -qi '<html\|<!DOCTYPE' "$TMPOUT" 2>/dev/null; then
    echo ""
    echo "Rapport ikke lagret av Claude — lagrer fra stdout-buffer..."
    cp "$TMPOUT" "$UTFIL"
  else
    echo "ADVARSEL: Ingen gyldig HTML-rapport generert."
    rm -f "$TMPOUT"
    exit 1
  fi
fi
rm -f "$TMPOUT"

# Send epost — alltid fra skriptet, aldri delegert til Claude
if [[ -f "$UTFIL" ]]; then
  /home/lars/.local/bin/hmail \
    --from "Klarsyn Analyse <testkonto5221@gmail.com>" \
    --to "$MOTTAKER" \
    --subject "Sammenligning: $NAVN1 vs $NAVN2 ($DATO)" \
    --file "$UTFIL" \
    && echo "Epost sendt til $MOTTAKER." \
    || echo "ADVARSEL: Epostsending feilet."
fi

# --- Legg til i RAG ---
if [[ -f "$UTFIL" ]]; then
  echo ""
  echo "Legger sammenligningsrapport til i RAG som: $RAG_KILDE"
  /home/lars/.local/bin/rag add "$UTFIL" "$RAG_KILDE" \
    && echo "RAG: OK" \
    || echo "RAG: FEIL (rapport er likevel lagret på disk)"
else
  echo "ADVARSEL: Rapportfil ikke funnet på $UTFIL — RAG-ingestion hoppet over."
fi

echo ""
echo "=== Ferdig ==="
echo "Rapport lagret: $UTFIL"
