#!/bin/bash
# tech-trend-analyse — Dyp analyse av én teknologi/språk/rammeverk via Claude Code CLI
#
# Bruk:
#   tech-trend-analyse "Rust"
#   tech-trend-analyse "WebAssembly" --to "annen@epost.no"
#   tech-trend-analyse "htmx" --budget 2.00
#   tech-trend-analyse "Kubernetes" --model claude-opus-4-6
#
# Bruker Sonnet for dypere resonnering. Standardmottaker: lsoraas@gmail.com

set -e

RAPPORTDIR="/home/lars/.openclaw/workspace/rapporter"
MALSTI="/home/lars/.openclaw/workspace/templates/tech-trend.html"
MOTTAKER="lsoraas@gmail.com"
BUDSJETT="1.50"
MODELL="claude-sonnet-4-6"
TEKNOLOGI=""

# --- Argumentparsing ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)     MOTTAKER="$2"; shift 2 ;;
    --budget) BUDSJETT="$2"; shift 2 ;;
    --model)  MODELL="$2"; shift 2 ;;
    *)        POSITIONAL+=("$1"); shift ;;
  esac
done

TEKNOLOGI="${POSITIONAL[0]:-}"

if [[ -z "$TEKNOLOGI" ]]; then
  echo "Feil: Oppgi en teknologi/språk/rammeverk."
  echo ""
  echo "Bruk:    tech-trend-analyse \"Rust\""
  echo "         tech-trend-analyse \"WebAssembly\" --to \"noen@epost.no\""
  echo "         tech-trend-analyse \"htmx\" --model claude-opus-4-6"
  exit 1
fi

DATO=$(date +%Y-%m-%d)
SLUG=$(echo "$TEKNOLOGI" \
  | sed 's/[æÆ]/ae/g; s/[øØ]/o/g; s/[åÅ]/a/g' \
  | tr '[:upper:]' '[:lower:]' \
  | tr -cs 'a-z0-9' '-' \
  | sed 's/^-//;s/-$//')

UTFIL="${RAPPORTDIR}/${DATO}_tech_${SLUG}.html"
RAG_KILDE="tech_${DATO}_${SLUG}"

mkdir -p "$RAPPORTDIR"

# --- Sjekk arkiv: send eksisterende hvis under 14 dager gammel ---
for kandidat in "$RAPPORTDIR"/*_tech_"${SLUG}".html; do
  [[ -f "$kandidat" ]] || continue
  alder_dager=$(( ( $(date +%s) - $(date -r "$kandidat" +%s 2>/dev/null || stat -c %Y "$kandidat" 2>/dev/null || echo 0) ) / 86400 ))
  if [[ $alder_dager -lt 14 ]]; then
    LAGRET_DATO=$(basename "$kandidat" .html | cut -d_ -f1)
    echo "✅ Analyse av \"$TEKNOLOGI\" finnes fra ${LAGRET_DATO} — sender fra arkiv."
    /home/lars/.local/bin/hmail \
      --to "$MOTTAKER" \
      --subject "Tech-analyse: $TEKNOLOGI ($LAGRET_DATO) [fra arkiv]" \
      --html < "$kandidat"
    echo "Sendt fra arkiv: $kandidat"
    exit 0
  fi
done

echo "=== tech-trend-analyse ==="
echo "Teknologi : $TEKNOLOGI"
echo "Modell    : $MODELL"
echo "Mottaker  : $MOTTAKER"
echo "Budsjett  : USD $BUDSJETT"
echo "Lagres    : $UTFIL"
echo ""
echo "Starter Claude Code CLI..."

PROMPT="Du er en teknologianalytiker som lager grundige trendrapporter for utviklere og tech-interesserte.

Din oppgave: Lag en dyp trendanalyse av teknologien: $TEKNOLOGI

INSTRUKSJONER:
1. Søk etter oppdatert data om $TEKNOLOGI: GitHub-aktivitet (stjerner, forks, bidragsytere), Stack Overflow Developer Survey-tall, TIOBE/RedMonk-rangering, jobbmarkedstrender (stillingstitler, vekst), pakkeregisterstatistikk (npm/crates.io/PyPI osv. etter hva som gjelder).
2. Les malen fra filen: $MALSTI
3. Generer en komplett HTML-rapport med samme CSS-stiler som malen. Tilpass innholdet til teknologianalyse (ikke investoranalyse).
4. Rapporten skal inneholde ALLE disse seksjonene:

<h2>1. Hva er $TEKNOLOGI?</h2>
Ett avsnitt: hva det er, hvem som laget det, kjernekonsept og bruksområde.

<h2>2. Adopsjonskurve og popularitet</h2>
Tabell med målbare tall: GitHub-stjerner og veksttakt, Stack Overflow-rangering siste 3 år, TIOBE/RedMonk-posisjon, antall npm/crates.io-nedlastinger per måned om relevant.
Trendretning: akselererer, stabil, avtagende?

<h2>3. Jobbmarked og etterspørsel</h2>
Antall stillingsutlysninger på LinkedIn/Indeed (søk og oppgi tall), lønnsnivå (USA som referanse), hvilke bransjer etterspør det mest, om veksten i etterspørsel er stigende eller fallende.

<h2>4. Økosystem og verktøykjede</h2>
De 5 viktigste bibliotekene/rammene rundt teknologien. Hvem er de store selskapene som bruker og støtter det? Er det bedriftsbåret (corporate-backed) eller fellesskapsdrevet?

<h2>5. Konkurrenter og alternativer</h2>
Sammenligningstabell mot 3-4 alternativer: modenhet, ytelse, læringskurve, jobbmarked, bruksområde. Vær konkret om hva hvert alternativ gjør bedre eller dårligere.

<h2>6. Styrker og svakheter</h2>
To kolonner: hva $TEKNOLOGI gjør genuint bra, og hva som er reelle begrensninger (ikke bare promotekst).

<h2>7. Tre scenarier (2-3 år frem)</h2>
Tabell:
| Scenario | Forutsetninger | Sannsynlig utfall | Sannsynlighet |
| Mainstream | ... | ... | XX% |
| Nisje / stabil | ... | ... | XX% |
| Fading / erstattet | ... | ... | XX% |

<h2>8. Hvem bør lære dette — og hvem bør vente?</h2>
Tabell med profiler (backend-utvikler, frontend-utvikler, data scientist, DevOps, tech lead) og anbefaling (Lær nå / Følg med / Ikke prioriter) med begrunnelse.

<h2>9. Ressurser og kom i gang</h2>
3-5 konkrete startpunkter: offisiell dokumentasjon, beste kurs/bok, viktigste fellesskapskanal.

<h2>10. Konklusjon og anbefaling</h2>
Tydelig dom: LÆR NÅ / FØLG MED / IKKE PRIORITER — og én setning om hvorfor.
Hva er den sterkeste grunnen til å investere tid i dette? Hva er den største risikoen?

Rapporten skal:
- Skrives på norsk, men tekniske termer kan beholdes på engelsk
- Tilpasses en utvikler eller tech-interessert ikke-spesialist
- Bruke CSS-klassene fra malen (box, box-green, box-red, table, verdict osv.)
- IKKE fabrikere tall — søk etter reelle data

LAGRE og SEND:
1. Lagre rapporten til: $UTFIL
2. Send med: /home/lars/.local/bin/hmail --to \"$MOTTAKER\" --subject \"Tech-analyse: $TEKNOLOGI ($DATO)\" --html < $UTFIL
3. Bekreft at eposten ble sendt.

Dato i dag: $DATO"

TMPOUT=$(mktemp --suffix=.html)

set +e
claude-kjor \
  --tittel "Tech-analyse: $TEKNOLOGI" \
  --mottaker "$MOTTAKER" \
  -- \
  --dangerously-skip-permissions \
  --model "$MODELL" \
  --max-budget-usd "$BUDSJETT" \
  --print \
  "$PROMPT" | tee "$TMPOUT"
CLAUDE_OK=${PIPESTATUS[0]}
set -e

if [[ $CLAUDE_OK -ne 0 ]]; then
  echo "FEIL: claude-kjor avsluttet med kode $CLAUDE_OK."
  rm -f "$TMPOUT"
  exit $CLAUDE_OK
fi

if [[ ! -f "$UTFIL" ]]; then
  if [[ -s "$TMPOUT" ]]; then
    echo ""
    echo "Rapport ikke lagret av Claude — lagrer fra stdout-buffer..."
    cp "$TMPOUT" "$UTFIL"
    /home/lars/.local/bin/hmail \
      --to "$MOTTAKER" \
      --subject "Tech-analyse: $TEKNOLOGI ($DATO)" \
      --html < "$UTFIL" \
      && echo "Epost sendt." \
      || echo "ADVARSEL: Epostsending feilet."
  else
    echo "ADVARSEL: Ingen rapport å lagre — stdout var tom."
  fi
fi
rm -f "$TMPOUT"

# --- Legg til i RAG ---
if [[ -f "$UTFIL" ]]; then
  echo ""
  echo "Legger tech-analyse til i RAG som: $RAG_KILDE"
  /home/lars/.local/bin/rag add "$UTFIL" "$RAG_KILDE" \
    && echo "RAG: OK" \
    || echo "RAG: FEIL (rapport er likevel lagret på disk)"
else
  echo "ADVARSEL: Rapportfil ikke funnet på $UTFIL — RAG-ingestion hoppet over."
fi

echo ""
echo "=== Ferdig ==="
echo "Rapport lagret: $UTFIL"
