#!/bin/bash
# ai-modell-sammenligning — Sammenlign 2-4 AI-modeller/leverandører via Claude Code CLI
#
# Bruk:
#   ai-modell-sammenligning "GPT-4o, Claude Sonnet, Gemini 2.5 Flash"
#   ai-modell-sammenligning "Llama 3.3, Mistral Large, Qwen 2.5" --to "annen@epost.no"
#   ai-modell-sammenligning "o3, Claude Opus, Gemini 2.0 Ultra" --budget 0.80
#
# Standardmottaker: lsoraas@gmail.com

set -e

RAPPORTDIR="/home/lars/.openclaw/workspace/rapporter"
MALSTI="/home/lars/.openclaw/workspace/templates/ai-modell.html"
MOTTAKER="lsoraas@gmail.com"
BUDSJETT="0.50"
MODELLER=""

# --- Argumentparsing ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)     MOTTAKER="$2"; shift 2 ;;
    --budget) BUDSJETT="$2"; shift 2 ;;
    *)        POSITIONAL+=("$1"); shift ;;
  esac
done

MODELLER="${POSITIONAL[0]:-}"

if [[ -z "$MODELLER" ]]; then
  echo "Feil: Oppgi 2-4 AI-modeller som første argument (kommaseparert)."
  echo ""
  echo "Bruk:    ai-modell-sammenligning \"GPT-4o, Claude Sonnet, Gemini 2.5 Flash\""
  echo "         ai-modell-sammenligning \"Llama 3.3, Mistral Large\" --to \"noen@epost.no\""
  exit 1
fi

DATO=$(date +%Y-%m-%d)
SLUG=$(echo "$MODELLER" \
  | sed 's/[æÆ]/ae/g; s/[øØ]/o/g; s/[åÅ]/a/g' \
  | tr '[:upper:]' '[:lower:]' \
  | tr -cs 'a-z0-9' '-' \
  | sed 's/^-//;s/-$//')

UTFIL="${RAPPORTDIR}/${DATO}_aimod_${SLUG}.html"
RAG_KILDE="aimod_${DATO}_${SLUG}"

mkdir -p "$RAPPORTDIR"

# --- Sjekk arkiv: send eksisterende hvis under 7 dager gammel ---
for kandidat in "$RAPPORTDIR"/*_aimod_"${SLUG}".html; do
  [[ -f "$kandidat" ]] || continue
  alder_dager=$(( ( $(date +%s) - $(date -r "$kandidat" +%s 2>/dev/null || stat -c %Y "$kandidat" 2>/dev/null || echo 0) ) / 86400 ))
  if [[ $alder_dager -lt 7 ]]; then
    LAGRET_DATO=$(basename "$kandidat" .html | cut -d_ -f1)
    echo "✅ AI-modellsammenligning finnes fra ${LAGRET_DATO} — sender fra arkiv."
    /home/lars/.local/bin/hmail \
      --to "$MOTTAKER" \
      --subject "AI-modellsammenligning: $MODELLER ($LAGRET_DATO) [fra arkiv]" \
      --file "$kandidat"
    echo "Sendt fra arkiv: $kandidat"
    exit 0
  fi
done

echo "=== ai-modell-sammenligning ==="
echo "Modeller : $MODELLER"
echo "Mottaker : $MOTTAKER"
echo "Budsjett : USD $BUDSJETT"
echo "Lagres   : $UTFIL"
echo ""
echo "Starter Claude Code CLI..."

PROMPT="Du er en AI-analytiker som sammenligner språkmodeller og AI-tjenester for praktisk bruk.

Din oppgave: Lag en detaljert sammenligning av disse AI-modellene: $MODELLER

INSTRUKSJONER:
1. Søk etter oppdatert data for hver modell: benchmarkresultater, prising per token, kontekstvindu, rate limits, tilgjengelighet via API, og nylige oppdateringer.
2. Les malen fra filen: $MALSTI
3. Generer en komplett HTML-rapport med samme CSS-stiler som malen. Tilpass antall kolonner til antall modeller.
4. Rapporten skal inneholde ALLE disse seksjonene:

<h2>1. Modellkort</h2>
Tabell med en kolonne per modell:
| Egenskap | [Modell 1] | [Modell 2] | ... |
| Leverandør | | | |
| Utgivelsesdato | | | |
| Modellstørrelse (om kjent) | | | |
| Kontekstvindu (tokens) | | | |
| Treningsdata cutoff | | | |
| Lisens (proprietær/åpen) | | | |
| API-tilgjengelighet | | | |

<h2>2. Benchmarks</h2>
Tabell med standardiserte benchmarks der data er tilgjengelig:
| Benchmark | Hva det måler | [Modell 1] | [Modell 2] | ... |
| MMLU | Akademisk kunnskap | | | |
| HumanEval | Kodegenerering | | | |
| MATH | Matematisk resonnering | | | |
| GPQA | Ekspertnivå-spørsmål | | | |
| LiveCodeBench | Fersk kodebenchmark | | | |
Merk tydelig der tall ikke er offisielt publisert.

<h2>3. Prising</h2>
Tabell: Input-pris per 1M tokens | Output-pris per 1M tokens | Eventuell gratis tier | Batch-rabatt | Maks tokens per forespørsel
Legg til en «verdi-for-pengene»-rad: hvilket brukstilfelle gir best ROI per modell?

<h2>4. Styrker per brukstilfelle</h2>
Tabell: brukstilfelle i rader, modeller i kolonner, score 🟢/🟡/🔴 med kort begrunnelse:
| Brukstilfelle | [Modell 1] | [Modell 2] | ... |
| Kodegenerering | | | |
| Lange dokumenter (summarisering) | | | |
| Flerspråklig tekst | | | |
| Funksjonskall / tool use | | | |
| Strukturert output (JSON) | | | |
| Kreativ skriving | | | |
| Matematikk og logikk | | | |
| Multimodal (bilde/lyd) | | | |

<h2>5. Praktisk API-erfaring</h2>
For hver modell: typisk latens (time-to-first-token), rate limits (RPM/TPM), pålitelighet/oppetid, SDK-støtte (Python/JS/andre), streaming-støtte, og om det finnes en playground/web-grensesnitt for testing.

<h2>6. Svakheter og kjente begrensninger</h2>
Hva er den største svakheten til hver modell? Hvor feiler de? Kjente problemer (hallusinasjoner, refusals, kontekst-tap, foreldete data osv.)

<h2>7. Hvem passer hvilken modell for?</h2>
Tabell: profil (indie-utvikler, startup, enterprise, forsker, privatperson) og hvilken modell som passer best for den profilen, med begrunnelse.

<h2>8. Anbefaling</h2>
Tydelig dom per scenario:
- Beste modell for kode: ...
- Beste modell for kostnad/ytelse: ...
- Beste modell for lange dokumenter: ...
- Beste open-source-alternativ: ...
- Beste modell totalt sett akkurat nå: ...

Rapporten skal:
- Skrives på norsk, men modellnavn og tekniske termer beholdes på engelsk
- Bruke CSS-klassene fra malen (box, box-green, box-red, table osv.)
- IKKE fabrikere benchmarktall — merk tydelig der offisielle tall mangler
- Fokusere på praktisk nytte, ikke tekniske detaljer for sin egen skyld

LAGRE og SEND:
1. Lagre rapporten til: $UTFIL
2. Send med: /home/lars/.local/bin/hmail --to \"$MOTTAKER\" --subject \"AI-modellsammenligning: $MODELLER ($DATO)\" --file $UTFIL
3. Bekreft at eposten ble sendt.

Dato i dag: $DATO"

TMPOUT=$(mktemp --suffix=.html)

set +e
claude-kjor \
  --tittel "AI-modellsammenligning: $MODELLER" \
  --mottaker "$MOTTAKER" \
  -- \
  --dangerously-skip-permissions \
  --model claude-haiku-4-5-20251001 \
  --max-budget-usd "$BUDSJETT" \
  --print \
  "$PROMPT" | tee "$TMPOUT"
CLAUDE_OK=${PIPESTATUS[0]}
set -e

if [[ $CLAUDE_OK -ne 0 ]]; then
  echo "FEIL: claude-kjor avsluttet med kode $CLAUDE_OK."
  rm -f "$TMPOUT"
  exit $CLAUDE_OK
fi

if [[ ! -f "$UTFIL" ]]; then
  if [[ -s "$TMPOUT" ]]; then
    echo ""
    echo "Rapport ikke lagret av Claude — lagrer fra stdout-buffer..."
    cp "$TMPOUT" "$UTFIL"
    /home/lars/.local/bin/hmail \
      --to "$MOTTAKER" \
      --subject "AI-modellsammenligning: $MODELLER ($DATO)" \
      --file "$UTFIL" \
      && echo "Epost sendt." \
      || echo "ADVARSEL: Epostsending feilet."
  else
    echo "ADVARSEL: Ingen rapport å lagre — stdout var tom."
  fi
fi
rm -f "$TMPOUT"

# --- Legg til i RAG ---
if [[ -f "$UTFIL" ]]; then
  echo ""
  echo "Legger AI-modellsammenligning til i RAG som: $RAG_KILDE"
  /home/lars/.local/bin/rag add "$UTFIL" "$RAG_KILDE" \
    && echo "RAG: OK" \
    || echo "RAG: FEIL (rapport er likevel lagret på disk)"
else
  echo "ADVARSEL: Rapportfil ikke funnet på $UTFIL — RAG-ingestion hoppet over."
fi

echo ""
echo "=== Ferdig ==="
echo "Rapport lagret: $UTFIL"
