#!/usr/bin/env bash
# hmail - simple himalaya send wrapper
# Usage: hmail --to ADDR --subject TEXT [--from ADDR] [--cc ADDR] [--body TEXT] [--html]
#        Body can also be passed via stdin if --body is omitted.
#        Use --html to send an HTML email (body must be valid HTML).

set -euo pipefail

FROM="testkonto5221@gmail.com"
TO=""
CC=""
SUBJECT=""
BODY=""
BODY_FROM_ARG=false
HTML=false
FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)    FROM="$2";    shift 2 ;;
    --to)      TO="$2";      shift 2 ;;
    --cc)      CC="$2";      shift 2 ;;
    --subject) SUBJECT="$2"; shift 2 ;;
    --body)    BODY="$(printf '%b' "$2")"; BODY_FROM_ARG=true; shift 2 ;;
    --html)    HTML=true;    shift ;;
    --file)    FILE="$2";    shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

[[ -z "$TO" ]]      && { echo "Error: --to is required" >&2; exit 1; }
[[ -z "$SUBJECT" ]] && { echo "Error: --subject is required" >&2; exit 1; }

if [[ -n "$FILE" ]]; then
  [[ -f "$FILE" ]] || { echo "Error: --file '$FILE' not found" >&2; exit 1; }
  BODY=$(cat "$FILE")
  HTML=true
elif [[ "$BODY_FROM_ARG" == false ]]; then
  BODY=$(cat)
fi

TMPFILE=$(mktemp /tmp/hmail-XXXXXX.eml)
trap 'rm -f "$TMPFILE"' EXIT

if [[ "$HTML" == true ]]; then
  {
    echo "From: $FROM"
    echo "To: $TO"
    [[ -n "$CC" ]] && echo "Cc: $CC"
    echo "Subject: $SUBJECT"
    echo "MIME-Version: 1.0"
    echo "Content-Type: text/html; charset=UTF-8"
    echo "Content-Transfer-Encoding: 8bit"
    echo ""
    echo "$BODY"
  } > "$TMPFILE"
else
  {
    echo "From: $FROM"
    echo "To: $TO"
    [[ -n "$CC" ]] && echo "Cc: $CC"
    echo "Subject: $SUBJECT"
    echo ""
    echo "$BODY"
  } > "$TMPFILE"
fi

/home/linuxbrew/.linuxbrew/bin/himalaya message send < "$TMPFILE"
